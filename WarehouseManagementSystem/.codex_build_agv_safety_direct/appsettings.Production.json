{



  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ApiTask": {
    "PollingIntervalSeconds": 10,
    "TimeoutSeconds": 30,
    "DefaultEndpoint": "http://api.example.com/tasks"
  },
  "AgvUpstream": {
    "TimeoutSeconds": 10,
    "MaxRetryCount": 10,
    "MaterialArrivedEndpoint": "http://10.200.178.89:9081/MES/AGV/matDeliv",
    "SafetySignalEndpoint": "http://10.200.178.89:9081/MES/AGV/safeSignal",
    "JobCompletedEndpoint": "http://10.200.178.89:9081/MES/AGV/taskComplete"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/warehouse-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
} 
